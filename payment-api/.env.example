# ZainCash
ZAINCASH_BASE_URL=https://pg-api-uat.zaincash.iq
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
ZAINCASH_API_KEY=
ZAINCASH_SCOPE=payment:read payment:write
ZAINCASH_SERVICE_TYPE=ForsaPromotion

# Public URL of this Vercel project, without a trailing slash
FORSA_PAYMENT_BASE_URL=https://YOUR-FORSA-PAYMENT-API.vercel.app

# Firebase Admin SDK service account JSON, kept only in the server environment.
FORSA_FIREBASE_SERVICE_ACCOUNT_JSON=

# Custom deep link used after the verified ZainCash callback.
FORSA_PAYMENT_DEEP_LINK=forsa://payment/result
