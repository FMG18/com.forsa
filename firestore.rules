rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isEmployer() {
      return request.auth != null
        && currentUser().role == "صاحب عمل"
        && currentUser().roleConfirmed == true;
    }

    function isVerifiedEmployer() {
      return isEmployer() && currentUser().verificationStatus == "verified";
    }

    function jobIsOpen(job) {
      return job.isActive == true
        && (
          ("expiresAt" in job && job.expiresAt > request.time.toMillis())
          || (
            !("expiresAt" in job)
            && ("createdAt" in job)
            && job.createdAt is int
            && job.createdAt + 30 * 24 * 60 * 60 * 1000 > request.time.toMillis()
          )
        );
    }

    match /jobs/{jobId} {
      allow read: if request.auth != null;

      allow create: if isVerifiedEmployer()
        && request.resource.data.keys().hasOnly([
          "title", "company", "city", "type", "description",
          "ownerUid", "createdAt", "expiresAt", "isActive"
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.company is string
        && request.resource.data.city is string
        && request.resource.data.type is string
        && request.resource.data.description is string
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 90 * 24 * 60 * 60 * 1000
        && request.resource.data.isActive == true;

      allow update: if isEmployer()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title", "company", "city", "type", "description", "isActive"
        ])
        && (!("isActive" in request.resource.data) || request.resource.data.isActive == true || request.resource.data.isActive == false)
        && (
          ("expiresAt" in resource.data && resource.data.expiresAt > request.time.toMillis())
          || (!("expiresAt" in resource.data)
              && ("createdAt" in resource.data)
              && resource.data.createdAt is int
              && resource.data.createdAt + 30 * 24 * 60 * 60 * 1000 > request.time.toMillis())
          || request.resource.data.isActive == false
        );

      allow delete: if isEmployer()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /savedJobs/{savedJobId} {
      allow create: if request.auth != null
        && request.resource.data.userUid == request.auth.uid
        && savedJobId == request.resource.data.jobId + "_" + request.auth.uid
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.ownerUid is string;

      allow read: if request.auth != null
        && resource.data.userUid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.userUid == request.auth.uid;

      allow update: if false;
    }

    match /applications/{applicationId} {
      allow create: if request.auth != null
        && currentUser().role == "باحث عن عمل"
        && currentUser().roleConfirmed == true
        && applicationId == request.resource.data.jobId + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly([
          "jobId", "jobTitle", "company", "applicantUid", "applicantName",
          "applicantEmail", "employerUid", "note", "status", "createdAt",
          "cvHeadline", "cvAbout", "cvEducation", "cvExperience",
          "cvSkills", "cvLanguages", "cvPhone", "cvCity"
        ])
        && request.resource.data.jobId is string
        && request.resource.data.jobId.size() > 0
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.applicantName is string
        && request.resource.data.applicantEmail is string
        && request.resource.data.employerUid is string
        && request.resource.data.note is string
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is int
        && request.resource.data.cvHeadline is string
        && request.resource.data.cvAbout is string
        && request.resource.data.cvEducation is string
        && request.resource.data.cvExperience is string
        && request.resource.data.cvSkills is string
        && request.resource.data.cvLanguages is string
        && request.resource.data.cvPhone is string
        && request.resource.data.cvCity is string
        && request.resource.data.employerUid ==
          get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.ownerUid
        && jobIsOpen(get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data)
        && request.resource.data.jobTitle ==
          get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.title
        && request.resource.data.company ==
          get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.company
        && request.resource.data.applicantName ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.applicantEmail ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
        && request.resource.data.cvPhone ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone
        && request.resource.data.cvCity ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.city
        && (
          !exists(/databases/$(database)/documents/cvProfiles/$(request.auth.uid))
          || (
            request.resource.data.cvHeadline ==
              get(/databases/$(database)/documents/cvProfiles/$(request.auth.uid)).data.headline
            && request.resource.data.cvAbout ==
              get(/databases/$(database)/documents/cvProfiles/$(request.auth.uid)).data.about
            && request.resource.data.cvEducation ==
              get(/databases/$(database)/documents/cvProfiles/$(request.auth.uid)).data.education
            && request.resource.data.cvExperience ==
              get(/databases/$(database)/documents/cvProfiles/$(request.auth.uid)).data.experience
            && request.resource.data.cvSkills ==
              get(/databases/$(database)/documents/cvProfiles/$(request.auth.uid)).data.skills
            && request.resource.data.cvLanguages ==
              get(/databases/$(database)/documents/cvProfiles/$(request.auth.uid)).data.languages
          )
        );

      allow read: if request.auth != null
        && (
          resource.data.applicantUid == request.auth.uid
          || resource.data.employerUid == request.auth.uid
          || get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.ownerUid == request.auth.uid
        );

      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "صاحب عمل"
        && resource.data.employerUid == request.auth.uid
        && request.resource.data.applicantUid == resource.data.applicantUid
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.employerUid == resource.data.employerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["pending", "accepted", "rejected"];

      allow delete: if request.auth != null
        && resource.data.applicantUid == request.auth.uid;
    }

    match /promotionOrders/{orderId} {
      // Payment orders are created and updated only by the trusted payment backend.
      allow create, update, delete: if false;

      allow read: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "targetUid", "actorUid", "type", "title", "body",
          "jobId", "applicationId", "status", "read", "createdAt"
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.type in ["new_application", "application_status"]
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.applicationId is string
        && request.resource.data.jobId is string
        && request.resource.data.status is string
        && request.resource.data.createdAt is int
        && request.resource.data.read == false
        && (
          (
            request.resource.data.type == "new_application"
            && request.resource.data.status == "pending"
            && request.resource.data.targetUid ==
              get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.employerUid
            && request.resource.data.jobId ==
              get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.jobId
            && request.resource.data.applicationId == request.resource.data.jobId + "_" + request.auth.uid
            && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.applicantUid == request.auth.uid
          )
          ||
          (
            request.resource.data.type == "application_status"
            && request.resource.data.status in ["pending", "accepted", "rejected"]
            && request.resource.data.targetUid ==
              get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.applicantUid
            && request.resource.data.jobId ==
              get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.jobId
            && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.employerUid == request.auth.uid
            && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.status == request.resource.data.status
          )
        );

      allow read: if request.auth != null
        && resource.data.targetUid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.targetUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        && request.resource.data.read == true;

      allow delete: if request.auth != null
        && resource.data.targetUid == request.auth.uid;
    }

    match /cvProfiles/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role in ["باحث عن عمل", "صاحب عمل"]
        && request.resource.data.roleConfirmed == true
        && (
          !("verificationStatus" in request.resource.data)
          || request.resource.data.verificationStatus == "unverified"
        );

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "displayName", "email", "phone", "city", "role", "roleConfirmed",
          "companyName", "companyAbout", "companyCity",
          "verificationStatus", "verificationRequestedAt", "verificationUpdatedAt", "verificationNote"
        ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.roleConfirmed == resource.data.roleConfirmed
        && (
          (
            (!("verificationStatus" in request.resource.data) && !("verificationStatus" in resource.data))
            || (
              ("verificationStatus" in request.resource.data)
              && ("verificationStatus" in resource.data)
              && request.resource.data.verificationStatus == resource.data.verificationStatus
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                "verificationRequestedAt", "verificationUpdatedAt", "verificationNote"
              ])
            )
          )
          || (
            (!("verificationStatus" in resource.data)
              || resource.data.verificationStatus in ["unverified", "rejected"])
            && request.resource.data.verificationStatus == "pending"
            && request.resource.data.verificationRequestedAt is int
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "verificationStatus", "verificationRequestedAt"
            ])
          )
        );

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
