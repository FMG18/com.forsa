rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /cvFiles/{userId}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
    match /employerVerificationDocs/{userId}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/jpeg|image/png'
        );

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /applicationCvs/{applicationId}/{fileName} {
      allow read: if request.auth != null
        && (
          get(/databases/(default)/documents/applications/$(applicationId)).data.applicantUid == request.auth.uid
          || get(/databases/(default)/documents/applications/$(applicationId)).data.employerUid == request.auth.uid
        );

      allow create, update: if request.auth != null
        && get(/databases/(default)/documents/applications/$(applicationId)).data.applicantUid == request.auth.uid
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/octet-stream'
        );

      allow delete: if request.auth != null
        && get(/databases/(default)/documents/applications/$(applicationId)).data.applicantUid == request.auth.uid;
    }

  }
}
